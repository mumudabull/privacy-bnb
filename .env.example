# Public New L1 devnet JSON-RPC. No key. The landing page reads this.
NEWL1_RPC_URL=https://newl1-devnet-rpc.bnbchain.org/

# --- Deploy / agent (testnet and devnet only). Never commit a real key. ---
# Hex private key of a throwaway deployer. Leave unset to run reads, quotes, and tests.
# PRIVATE_KEY=
#
# Password the BNBAgent SDK uses to encrypt the local keystore (~/.bnbagent/wallets/).
# WALLET_PASSWORD=
#
# Public base URL of the deployed site, for example https://your-app.vercel.app.
# `register` publishes <AGENT_PUBLIC_URL>/api/mcp in the ERC-8004 registration.
# AGENT_PUBLIC_URL=
#
# Extra browser origins allowed to call /api/mcp, comma separated. Requests with
# no Origin header (ordinary MCP clients) and same-origin requests always pass.
# MCP_ALLOWED_ORIGINS=
#
# BSC testnet (chain id 97). The SDK default data-seed host is unreachable.
# RPC_URL_BSC_TESTNET=https://bsc-testnet-dataseed.bnbchain.org
# AGENT_PUBLIC_URL=https://hack.darkswap.app
# DEMO_RNOTE_PER_BNB=555
#
# New L1 devnet has no faucet. Devnet BNB is bridged from BSC testnet tBNB.
# Deploying the rehearsal contracts there needs a funded devnet key in PRIVATE_KEY.
#
# Agent broadcast of the PUBLIC rehearsal. The sender must be unlocked on RPC_URL
# (anvil). This path does not read PRIVATE_KEY.
# RPC_URL=http://127.0.0.1:8545
# REHEARSAL=
# SENDER=
# DARKSWAP_CAP_WEI=50000000000000000
#
# Anthropic API key. Optional, used only by the Python agent. When set, sentences
# the built-in pattern cannot parse are read by a Claude model through one forced
# tool call. The cap and market guards still decide. Never commit or log it.
# The hosted /api/mcp endpoint never reads this key.
# ANTHROPIC_API_KEY=
# DARKSWAP_INTENT_MODEL=claude-haiku-5-5
#
# CoinMarketCap Pro. Sent only as a request header. Never commit or log it.
# CMC_API_KEY=
# CMC_MAX_DEVIATION_BPS=500
# CMC_LOG_PATH=agent/logs/cmc-requests.jsonl
#
# Atlas-compatible AggregatorV3. Required to deploy the guarded rehearsal.
# No BNB/USD SingleFeed on BSC testnet was in the public catalog on 25 Nov 2026.
# ORACLE_FEED=0x3957d289ee9C38272377786787ea34F9dd29788D
# The address above is the Atlas SingleFeed BNB/USD on BSC testnet (chain 97).
# The site reads it on chain for the market check; BSC_TESTNET_RPC_URL overrides the RPC.
# MAX_DEVIATION_BPS=500
# MAX_STALE_SECONDS=3600
